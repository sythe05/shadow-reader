# ---------- Sarvam AI ----------
SARVAM_API_KEY=

# Text-to-speech (Bulbul)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000

# Speech-to-text (Saaras)
SARVAM_STT_MODEL=saaras:v3
# transcribe | verbatim | translit | codemix  (translate returns English, don't use it here)
SARVAM_STT_MODE=transcribe
LANGUAGE_CODE=hi-IN

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shadowreader123
NEO4J_DATABASE=neo4j

# ---------- Adaptive behaviour ----------
# A student->phoneme edge counts as a "struggle" above this error_rate (step 1 of the workflow)
STRUGGLE_THRESHOLD=0.7
# Pace for normal words, and the slowest pace used for a phoneme with error_rate = 1.0
BASE_PACE=1.0
SLOW_MIN_PACE=0.55
# How fast error_rate moves after each attempt (exponential moving average, after the first few attempts)
ERROR_RATE_ALPHA=0.12
# Starting error_rate when a phoneme is first observed for a student
PHONEME_PRIOR=0.5

# ---------- Scoring ----------
# Minimum spelling similarity (0-1) between expected and heard word to count it as read correctly
WORD_MATCH_THRESHOLD=0.85
MAX_PASSAGE_WORDS=40

# ---------- Misc ----------
CACHE_DIR=.cache
HOST=127.0.0.1
PORT=8000
